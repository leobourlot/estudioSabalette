# Hostinger: toda ruta que no sea un archivo o carpeta existente se sirve con index.html,
# para que las rutas de React (por ejemplo /panel/usuarios) funcionen al recargar.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dirección única del sitio: sin www y con HTTPS (plan 004, "Dirección única del sitio").
  # En un solo salto, conservando la ruta y los parámetros; el dominio se toma del pedido.
  # Temporal (302) hasta verificarla en producción; después pasa a permanente (301).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=302,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
