# Copiar como .env (desarrollo) y .env.test (tests e2e) y completar con los datos reales.
# Nunca usar la base de producción en ninguno de los dos.

# Puerto HTTP de la API (por defecto 3000).
PORT=3000

# Conexión a MySQL. DB_PORT por defecto: 3306.
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Secreto para firmar los tokens de acceso. Mínimo 32 caracteres, aleatorio.
JWT_SECRET=

# Cantidad de proxys delante de la API: 0 en desarrollo, 1 en Easypanel (Traefik).
TRUST_PROXY_HOPS=0

# Orígenes del frontend permitidos por CORS, separados por comas.
# Desarrollo: http://localhost:5173 — Producción: https://estudio.com,https://www.estudio.com
FRONTEND_ORIGINS=http://localhost:5173
